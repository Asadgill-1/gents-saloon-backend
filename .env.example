# Runtime
ENV=development
LOG_LEVEL=INFO
APP_BASE_URL=http://localhost:8000
WEBHOOK_BASE_URL=
SHOP_DASHBOARD_URL=http://localhost:3000
PLATFORM_DASHBOARD_URL=http://localhost:3001
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# PostgreSQL / Supabase — backend only except the two public frontend values
DATABASE_URL=postgresql://postgres:local-dev-password@localhost:5432/gents_saloon
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWKS_TIMEOUT_SECONDS=5

# Redis / Celery
# Docker Compose uses port 6379. For the native Windows fallback documented in
# backend/README.md, change all three URLs below to 127.0.0.1:6380.
REDIS_URL=redis://:local-dev-password@localhost:6379/0
CELERY_BROKER_URL=redis://:local-dev-password@localhost:6379/0
CELERY_RESULT_BACKEND=redis://:local-dev-password@localhost:6379/0

# Telegram
MASTER_BOT_TOKEN=
PLATFORM_ADMIN_TELEGRAM_IDS=

# AI — verify current endpoint/model against official Moonshot docs at build time
MOONSHOT_API_KEY=
MOONSHOT_BASE_URL=
MOONSHOT_MODEL=

# Encryption
TOKEN_ENCRYPTION_KEY=

# Tenant exports (private Supabase Storage; bucket must never be public)
EXPORT_STORAGE_BUCKET=tenant-exports
EXPORT_DOWNLOAD_TTL_SECONDS=900
EXPORT_RETENTION_HOURS=72

# API abuse controls (per identity/IP and stable route, 60-second window)
AUTHENTICATED_RATE_LIMIT_PER_MINUTE=120
PLATFORM_MUTATION_RATE_LIMIT_PER_MINUTE=60
PUBLIC_RATE_LIMIT_PER_MINUTE=300

# Optional telemetry; never include PII or secrets
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=gents-saloon-backend
