# Backend-only runtime template. Populate in the approved staging/production secret store.
ENV=production
LOG_LEVEL=INFO
APP_BASE_URL=https://api.example.invalid
WEBHOOK_BASE_URL=https://api.example.invalid
SHOP_DASHBOARD_URL=https://shop.example.invalid
PLATFORM_DASHBOARD_URL=https://platform.example.invalid
CORS_ORIGINS=https://shop.example.invalid,https://platform.example.invalid

DATABASE_URL=
SUPABASE_URL=https://project-ref.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_AUDIENCE=authenticated

REDIS_URL=
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

MOONSHOT_API_KEY=
MOONSHOT_BASE_URL=
MOONSHOT_MODEL=
TOKEN_ENCRYPTION_KEY=
TELEGRAM_WEBHOOK_HMAC_KEY=
EXPORT_STORAGE_BUCKET=tenant-exports

# Grafana Cloud OTLP endpoint and Basic auth header stay in the secret store.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=otlp
OTEL_LOGS_EXPORTER=otlp
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=production,service.namespace=gents-saloon
OTEL_PYTHON_LOG_CORRELATION=true
